MOCK_MODE=true
LOOKBACK_HOURS=48
MIN_SIGNIFICANCE_SCORE=6.5
MAX_SCOUT_RESULTS=30
MAX_ANALYSIS_EVENTS=12
SEARCH_QUERIES_COUNT=8
VERIFY_SOURCES_MIN=2
VERIFY_SOURCES_TARGET=3
SCORING_WEIGHTS={"importance":0.30,"impact":0.25,"practicality":0.20,"novelty":0.15,"confidence":0.10}
LLM_BASE_URL=https://agentrouter.org/v1
LLM_API_KEY=
TAVILY_API_KEY=
# Set model IDs offered by your provider; empty role overrides use LLM_MODEL.
LLM_MODEL=configure-model-id
SCOUT_MODEL=
VERIFIER_MODEL=
CONTEXT_MODEL=
IMPACT_MODEL=
EDITOR_MODEL=
LLM_RESPONSE_FORMAT=json_object
LLM_MAX_OUTPUT_TOKENS=6000
MAX_LLM_CALLS=80
MAX_SEARCH_CALLS=80
MAX_PAGE_FETCHES=80
MAX_INPUT_CHARS=70000
MODEL_PRICES={}
DATABASE_PATH=data/intelligence.sqlite3
ENABLE_ALFA_RELEVANCE=false
